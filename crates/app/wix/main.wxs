<?xml version="1.0" encoding="windows-1252"?>
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" Name="Strata Mundi" UpgradeCode="6E0C9C1E-6E3B-4F7B-9D0A-5A7C2B1F4E21"
             Manufacturer="Strata Mundi" Language="1033" Codepage="1252" Version="$(var.Version)">
        <Package Id="*" Keywords="Installer" Description="Strata Mundi voxel sandbox"
                 Manufacturer="Strata Mundi" InstallerVersion="450" Languages="1033"
                 Compressed="yes" InstallScope="perMachine" SummaryCodepage="1252"/>
        <MajorUpgrade Schedule="afterInstallInitialize"
                      DowngradeErrorMessage="A newer version of Strata Mundi is already installed."/>
        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes"/>
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="$(var.PlatformProgramFilesFolder)">
                <Directory Id="APPLICATIONFOLDER" Name="Strata Mundi">
                    <Component Id="Binary" Guid="*">
                        <File Id="StrataExe" Name="strata.exe" DiskId="1" KeyPath="yes"
                              Source="$(var.CargoTargetBinDir)\strata.exe"/>
                    </Component>
                    <Component Id="Licenses" Guid="*">
                        <File Id="LicenseFile" Name="LICENSE.txt" DiskId="1" KeyPath="yes" Source="LICENSE"/>
                        <File Id="LicenseContentFile" Name="LICENSE-CONTENT.txt" DiskId="1"
                              Source="LICENSE-CONTENT"/>
                    </Component>
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Component Id="StartMenuShortcut" Guid="*">
                    <Shortcut Id="StrataShortcut" Name="Strata Mundi" Target="[APPLICATIONFOLDER]strata.exe"
                              WorkingDirectory="APPLICATIONFOLDER"/>
                    <RegistryValue Root="HKCU" Key="Software\StrataMundi" Name="installed" Type="integer"
                                   Value="1" KeyPath="yes"/>
                </Component>
            </Directory>
        </Directory>
        <Feature Id="Main" Title="Strata Mundi" Level="1" ConfigurableDirectory="APPLICATIONFOLDER"
                 AllowAdvertise="no" Display="expand" Absent="disallow">
            <ComponentRef Id="Binary"/>
            <ComponentRef Id="Licenses"/>
            <ComponentGroupRef Id="Assets"/>
            <ComponentRef Id="StartMenuShortcut"/>
        </Feature>
        <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER"/>
        <WixVariable Id="WixUILicenseRtf" Value="crates\app\wix\License.rtf"/>
        <UIRef Id="WixUI_InstallDir"/>
    </Product>
</Wix>
