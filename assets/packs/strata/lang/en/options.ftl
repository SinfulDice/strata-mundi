action-hotbar-6 = Slot 6
action-hotbar-7 = Slot 7
action-hotbar-8 = Slot 8
action-hotbar-9 = Slot 9
action-render-distance-down = See less far
action-render-distance-up = See farther
action-toggle-debug = Debug info
action-reload-resources = Reload resources
action-open-console = Console
option-tab-packs = Packs
option-pack-rank = on (#{ $rank })
option-pack-help = Confirm: enable/disable. Left/right: priority.
option-packs-none = No resource packs
option-packs-none-help = Put a pack in the resourcepacks folder.

# Sound
option-tab-sound = Sound
option-master-volume = Master volume
option-master-volume-help = Volume of every sound. No effect on performance; without a sound card the game runs silently.
option-blocks-volume = Blocks
option-blocks-volume-help = Footsteps, broken and placed blocks, water, lava and fire.
option-ambient-volume = Ambience
option-ambient-volume-help = Sounds of the place: wind, biome and cave ambiences.
option-music-volume = Music
option-music-volume-help = Volume of the music.
option-music-frequency = Music frequency
option-music-frequency-help = Silence between two pieces: rare (10 to 20 minutes), normal (5 to 10), often (2 to 5). To turn the music off, set its volume to 0.
music-rare = Rare
music-normal = Normal
music-often = Often
option-subtitles = Subtitles
option-subtitles-help = Writes every sound heard at the bottom right, with an arrow towards it.
option-spatial-audio = Spatial audio
option-spatial-audio-help = Advanced: echo of the place (cave, house, open air) and sounds muffled behind walls. Simple stereo: distance and left/right only, less work (DS preset).
spatial-advanced = Advanced
spatial-simple = Simple stereo
