// Terra, the world of mortals.
Dimension(
    // A full day and night in ticks (20 per second): 24 000 = 20 minutes. `day_share` is
    // the part of it when the sun is up; `twilight` the part each sunrise and sunset takes;
    // `night_light` the sky light left at night.
    day: (
        length: 24000,
        day_share: 0.5,
        twilight: 0.06,
        night_light: 0.1,
    ),
    terrain: (
        sea_level: 120,
        deep_level: 64,
        stone: "strata:stone",
        deep_stone: "strata:deep_stone",
        bedrock: "strata:bedrock",
        water: "strata:water",
        ice: "strata:ice",
        biome_scale: 1.0,
        // Caves; `enabled: false` turns them off.
        caves: (
            enabled: true,
            density: 1.0,
            spaghetti: 0.075,
            noodles: 0.05,
            noodle_top: 100,
            cheese: 0.3,
            cavern_top: 140,
            ravines: 0.03,
            ravine_depth: (30, 80),
            aquifers: 0.35,
            aquifer_cell: 64,
            aquifer_top: 100,
            aquifer_depth: 48,
            lava_level: 10,
            lava: "strata:lava",
        ),
        ores: ["strata:coal_ore", "strata:iron_ore", "strata:gold_ore", "strata:diamond_ore", "strata:copper_ore"],
        // Giant ore veins, rare and rich; an empty list turns them off.
        deposits: ["strata:iron_deposit", "strata:copper_deposit"],
        // Curves of the climate maps, in blocks above the sea (see docs/explications/relief.md).
        relief: (
            continent: [(-1.0, -55.0), (-0.65, -38.0), (-0.4, -16.0), (-0.28, -4.0), (-0.2, 1.5), (0.0, 5.0), (0.4, 12.0), (1.0, 26.0)],
            inland: [(-0.2, 0.0), (0.25, 1.0)],
            rugged: [(-0.75, 1.0), (-0.3, 0.0)],
            peaks: [(-1.0, 20.0), (-0.4, 40.0), (0.2, 95.0), (0.7, 170.0), (1.0, 230.0)],
            hills: [(-1.0, -3.0), (-0.2, 4.0), (0.4, 12.0), (1.0, 22.0)],
            plateau: [(0.25, 0.0), (0.35, 1.0), (0.55, 1.0), (0.65, 0.0)],
            plateau_lift: 26.0,
            terrace_step: 9.0,
            overhang: [(-0.8, 1.0), (-0.3, 0.55), (0.1, 0.12), (0.25, 0.0)],
            overhang_blocks: 22.0,
            rivers: Some((width: 0.022, banks: 0.06, depth: 5.0, highest: 45.0)),
            // Humid, flat lowlands sink to the sea: the pools and islets of swamps.
            wetlands: Some((
                humidity: [(0.3, 0.0), (0.42, 1.0), (0.56, 1.0), (0.66, 0.0)],
                erosion: [(0.58, 0.0), (0.72, 1.0)],
                level: -0.5,
                bumps: 3.0,
            )),
        ),
    ),
)
