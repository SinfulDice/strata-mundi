Biome(
    climate: (temperature: 0.15, humidity: 0.35, continentalness: 0.2, erosion: 0.2),
    heat: Some((1, 3)),
    map_color: "#3f7d34",
    surface: "strata:grass_block",
    subsurface: "strata:dirt",
