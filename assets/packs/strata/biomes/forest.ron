    spawn: true,
    features: [
        (feature: "strata:oak_tree", per_column: 5.5),
        (feature: "strata:birch_tree", per_column: 1.5),
        (feature: "strata:tall_grass", per_column: 3.0),
        (feature: "strata:ferns", per_column: 1.5),
        (feature: "strata:mushrooms", per_column: 0.6),
        (feature: "strata:bushes", per_column: 0.8),
    ],
    colors: (
        grass: (0.92, 1.0, 0.88),
        foliage: (0.92, 1.0, 0.88),
        water: (1.0, 1.0, 1.0),
        fog: (1.0, 1.0, 1.0),
    ),
)
