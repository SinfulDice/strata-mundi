// Up to the snowy peaks, which take over above `max_height`.
Biome(
    climate: (temperature: -0.05, humidity: 0.0, continentalness: 0.45, erosion: -0.6),
    map_color: "#8a8a8a",
    max_height: 230,
    surface: "strata:grass_block",
    subsurface: "strata:dirt",
    underwater: "strata:gravel",
    peaks: [(200, "strata:stone"), (265, "strata:snow_block")],
    features: [
        (feature: "strata:fir_tree", per_column: 1.5),
        (feature: "strata:tall_grass", per_column: 0.8),
    ],
)
