// Reinforcement: more uses, and more protection for armour. Heavier: it does not go with
// lightening.
Upgrade(
    slot: "strata:craft",
    applies_to: ["strata:tools", "strata:weapons", "strata:armour"],
    excludes: ["strata:lightening"],
    levels: [
        Level(effects: [Stat(stat: "strata:durability", op: Percent, value: 20.0), Stat(stat: "strata:protection", op: Add, value: 1.0)], xp: 2, material: Item("strata:iron_ingot"), count: 2),
        Level(effects: [Stat(stat: "strata:durability", op: Percent, value: 40.0), Stat(stat: "strata:protection", op: Add, value: 2.0)], xp: 4, material: Item("strata:iron_ingot"), count: 4),
        Level(effects: [Stat(stat: "strata:durability", op: Percent, value: 60.0), Stat(stat: "strata:protection", op: Add, value: 3.0)], xp: 7, material: Item("strata:diamond"), count: 2),
    ],
)
