// Sharpening: a keener edge, more damage and faster digging. Each level replaces the one
// before (it does not add up with it).
Upgrade(
    slot: "strata:craft",
    applies_to: ["strata:tools", "strata:weapons"],
    levels: [
        Level(effects: [Stat(stat: "strata:damage", op: Percent, value: 10.0), Stat(stat: "strata:mining_speed", op: Percent, value: 10.0)], xp: 2, material: Item("strata:copper_ingot"), count: 2),
        Level(effects: [Stat(stat: "strata:damage", op: Percent, value: 20.0), Stat(stat: "strata:mining_speed", op: Percent, value: 20.0)], xp: 4, material: Item("strata:iron_ingot"), count: 2),
        Level(effects: [Stat(stat: "strata:damage", op: Percent, value: 30.0), Stat(stat: "strata:mining_speed", op: Percent, value: 30.0)], xp: 7, material: Item("strata:diamond"), count: 1),
    ],
)
