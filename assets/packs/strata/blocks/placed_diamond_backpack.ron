// A diamond backpack put down (sneak + right click with it): 81 slots and 4 upgrade slots (storage_tiers/backpack_diamond.ron).
// Breaking it gives the backpack back with all it holds; it never burns. A kit raises its tier in place.
Block(
    textures: TopBottomSides(top: "strata:diamond_backpack_top", bottom: "strata:diamond_backpack_side", sides: "strata:diamond_backpack_side"),
    hardness: 0.8,
    sound: Some("strata:wool"),
    has_item: false,
    container: Some(Container(upgradable: Some(Upgradable(family: "strata:backpack", tier: "strata:backpack_diamond")))),
)
