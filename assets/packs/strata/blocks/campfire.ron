    textures: All("strata:campfire"),
    render: Cross,
    solid: false,
    light_opacity: 0,
    light_emission: 15,
    hardness: 1.0,
    sound: Some("strata:wood"),
    category: Some("strata:building"),
    rooted: true,
)
