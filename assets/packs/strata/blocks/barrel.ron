// A barrel: 27 slots and no upgrade slots (storage_tiers/wood.ron), never joined with its neighbours.
Block(
    textures: Column(end: "strata:barrel_top", side: "strata:barrel_side"),
    hardness: 2.5,
    tool: Some(BlockTool(kind: "strata:axe")),
    sound: Some("strata:wood"),
    category: Some("strata:storage"),
    container: Some(Container(upgradable: Some(Upgradable(family: "strata:barrel", tier: "strata:wood")))),
    flammability: Some((catch: 5, burn: 20)),
)
