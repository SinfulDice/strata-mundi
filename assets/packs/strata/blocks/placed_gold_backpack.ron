// A gold backpack put down (sneak + right click with it): 63 slots and 3 upgrade slots (storage_tiers/backpack_gold.ron).
// Breaking it gives the backpack back with all it holds; it never burns. A kit raises its tier in place.
Block(
    textures: TopBottomSides(top: "strata:gold_backpack_top", bottom: "strata:gold_backpack_side", sides: "strata:gold_backpack_side"),
    hardness: 0.8,
    sound: Some("strata:wool"),
    has_item: false,
    container: Some(Container(upgradable: Some(Upgradable(family: "strata:backpack", tier: "strata:backpack_gold")))),
)
