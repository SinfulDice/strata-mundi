// Mostly sea, with islands of every size: the continentalness noise is pushed down to the
// coasts, so only its highest values rise above the water.
WorldType(
    order: 4,
    relief: (
        continent_scale: 0.45,
        continentalness: [(-1.0, -1.0), (0.0, -0.6), (0.3, -0.4), (0.45, -0.22), (0.6, 0.05), (0.85, 0.25), (1.0, 0.4)],
    ),
)
