        '-': (accent: None, rows: ["....", "....", "....", "####", "....", "....", "...."]),
        '+': (accent: None, rows: [".....", "..#..", "..#..", "#####", "..#..", "..#..", "....."]),
        '=': (accent: None, rows: [".....", ".....", "#####", ".....", "#####", ".....", "....."]),
