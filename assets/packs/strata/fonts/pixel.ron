// Pixel font of the strata pack: 5 px wide, 7 px cap height, 2 px descenders.
// `rows` start at the cap line; extra rows go below the baseline. `accent` rows
// sit above (lowercase letters drop them into their ascender space).
// Replaceable by a resource pack (fonts/pixel.ron).
Font(
    line_height: 11,
    ascent: 9,
    glyphs: {
        'A': (accent: None, rows: [".###.", "#...#", "#...#", "#####", "#...#", "#...#", "#...#"]),
        'B': (accent: None, rows: ["####.", "#...#", "#...#", "####.", "#...#", "#...#", "####."]),
        'C': (accent: None, rows: [".###.", "#...#", "#....", "#....", "#....", "#...#", ".###."]),
        'D': (accent: None, rows: ["####.", "#...#", "#...#", "#...#", "#...#", "#...#", "####."]),
        'E': (accent: None, rows: ["#####", "#....", "#....", "####.", "#....", "#....", "#####"]),
        'F': (accent: None, rows: ["#####", "#....", "#....", "####.", "#....", "#....", "#...."]),
        'G': (accent: None, rows: [".###.", "#...#", "#....", "#.###", "#...#", "#...#", ".####"]),
        'H': (accent: None, rows: ["#...#", "#...#", "#...#", "#####", "#...#", "#...#", "#...#"]),
        'I': (accent: None, rows: ["###", ".#.", ".#.", ".#.", ".#.", ".#.", "###"]),
