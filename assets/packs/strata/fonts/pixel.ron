        'P': (accent: None, rows: ["####.", "#...#", "#...#", "####.", "#....", "#....", "#...."]),
        'Q': (accent: None, rows: [".###.", "#...#", "#...#", "#...#", "#.#.#", "#..#.", ".##.#"]),
