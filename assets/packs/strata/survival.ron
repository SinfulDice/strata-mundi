// Survival gauges (v0.3, milestone 8). Health in points (2 per heart), times in ticks
// (20 a second). Exhaustion is Minecraft's: 4 of it cost one point of saturation, then of
// food. World options turn hunger, thirst and stamina off or change their speed.
Survival(
    health: (
        max: 20.0,
        regen_food: 18.0,
        regen_every: 80,
        saturated_every: 10,
        regen_amount: 1.0,
        regen_cost: 6.0,
        starve_every: 80,
        starve_damage: 1.0,
        starve_floor: 1.0,
    ),
    hunger: (
        max: 20.0,
        start_saturation: 5.0,
        per_point: 4.0,
        sprint: 0.1,
        jump: 0.05,
        sprint_jump: 0.2,
        swim: 0.01,
        mine: 0.005,
        attack: 0.1,
        sprint_min: 6.0,
    ),
    thirst: (
        max: 20.0,
        per_point: 4.0,
        share: 0.75,
        idle: 0.0025,
        dry_every: 80,
        dry_damage: 1.0,
        floor: 1.0,
    ),
    stamina: (
        max: 100.0,
        regen: 1.0,
        delay: 15,
        sprint: 0.6,
        jump: 6.0,
        attack: 10.0,
        dash: 20.0,
        resume: 25.0,
    ),
    breath: (
        seconds: 15.0,
        refill: 5,
        drown_every: 20,
        drown_damage: 2.0,
    ),
    fall: (safe: 3.0, per_block: 1.0),
    armor: (per_point: 0.04, max: 0.8),
    drinking: (
        source: "strata:water",
        sip: 2.0,
        salty_sip: -1.0,
        salty_biomes: ["strata:ocean", "strata:deep_ocean", "strata:beach"],
    ),
    invulnerability: 10,
    suffocation_every: 10,
    suffocation_damage: 1.0,
)
