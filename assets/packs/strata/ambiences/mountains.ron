// Mountains and snow: wind, stronger near the summits, a gust now and then.
Ambience(
    biomes: ["strata:mountains", "strata:warm_mountains", "strata:snowy_peaks", "strata:snowy_tundra"],
    beds: [
        (sound: "strata:ambient_wind", volume: 0.45, altitude: (from: 140, to: 320, gain: (0.6, 1.3))),
    ],
    events: [
        (sound: "strata:wind", every: (35.0, 90.0), distance: (8.0, 16.0)),
    ],
)
