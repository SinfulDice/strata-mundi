// Mountains and snow: strong wind, much stronger near the summits, frequent gusts.
Ambience(
    biomes: ["strata:mountains", "strata:warm_mountains", "strata:snowy_peaks", "strata:snowy_tundra"],
    beds: [
        (sound: "strata:ambient_wind", volume: 0.7, altitude: (from: 140, to: 320, gain: (0.6, 1.6))),
    ],
    events: [
        (sound: "strata:wind", every: (12.0, 30.0), distance: (8.0, 16.0)),
    ],
)
