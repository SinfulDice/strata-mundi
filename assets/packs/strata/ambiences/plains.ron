// Open grassland: wind that grows stronger with height, a rare gust.
Ambience(
    biomes: ["strata:plains", "strata:flower_meadow", "strata:savanna", "strata:river"],
    beds: [
        (sound: "strata:ambient_wind", volume: 0.35, altitude: (from: 130, to: 220, gain: (0.7, 1.2))),
    ],
    events: [
        (sound: "strata:wind", every: (60.0, 150.0), distance: (8.0, 16.0)),
    ],
)
