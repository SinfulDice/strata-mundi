// A wooden boat, in sixteenths of a block around its origin (bottom centre); the prow
// points north (-Z) at yaw 0.
Model(
    boxes: [
        (from: (-10, 0, -14), to: (10, 2, 14)),
        (from: (-10, 2, -14), to: (-8, 7, 14)),
        (from: (8, 2, -14), to: (10, 7, 14)),
        (from: (-8, 2, -14), to: (8, 7, -12)),
        (from: (-8, 2, 12), to: (8, 7, 14)),
        (from: (-6, 1, -17), to: (6, 6, -14)),
        (from: (-8, 4, 1), to: (8, 5, 5)),
    ],
)
