// Theme of Terra: a calm piano over soft chords, in the wondering light of the Lydian mode.
// Each piece is composed from a seed (`pieces` of them) and rendered once into the cache.
Theme(
    dimensions: ["strata:terra"],
    title: true,
    root: 50,                      // D3 (MIDI); the melody plays an octave higher
    scale: Lydian,
    tempo: 66,                     // beats per minute
    pieces: 5,
    length: (75.0, 170.0),         // seconds
    density: 0.5,                  // 0: a few notes, 1: phrases close together
    rests: (5.0, 11.0),            // seconds of silence between two phrases
    chords: [0, 0, 1, 3, 4, 5],    // degrees the chords stand on (repeated = more often)
    motifs: [
        Motif(degrees: [0, 2, 4], beats: [1.0, 1.0, 2.0]),
        Motif(degrees: [4, 3, 2, 0], beats: [1.0, 1.0, 1.0, 3.0]),
        Motif(degrees: [2, 4, 7, 4], beats: [1.5, 0.5, 2.0, 2.0]),
        Motif(degrees: [0, -1, 0, 2], beats: [2.0, 1.0, 1.0, 3.0]),
        Motif(degrees: [7, 4, 2], beats: [1.0, 1.0, 4.0]),
        Motif(degrees: [4, 5, 4, 2, 0], beats: [1.0, 0.5, 1.5, 1.0, 3.0]),
    ],
    piano: Piano(
        volume: 0.9,
        decay: 4.5,                // seconds for a middle C to die away
        brightness: 0.4,
        octave: 1,
        bass: 0.6,                 // chance of a low note under a phrase
    ),
    pad: Pad(
        volume: 0.45,
        attack: 3.0,
        release: 4.0,
        cutoff: 900.0,
        octave: 0,
        chance: 0.45,              // chance that a phrase is held by a chord
    ),
    room: (size: 0.75, wet: 0.35),
    volume: 0.85,
)
