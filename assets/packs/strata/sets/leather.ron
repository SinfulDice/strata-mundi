// Each bonus replaces the one before: it repeats what it keeps of it.
Set(
    pieces: [
        "strata:leather_cap",
        "strata:leather_tunic",
        "strata:leather_pants",
        "strata:leather_boots",
    ],
    bonuses: [
        Bonus(pieces: 2, effects: [Stat(stat: "strata:protection", op: Add, value: 1.0)]),
        Bonus(pieces: 4, effects: [Stat(stat: "strata:protection", op: Add, value: 2.0), Stat(stat: "strata:insulation", op: Add, value: 1.0)]),
    ],
)
