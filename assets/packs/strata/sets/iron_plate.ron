// Each bonus replaces the one before: it repeats what it keeps of it.
Set(
    pieces: [
        "strata:iron_plate_helmet",
        "strata:iron_plate_chestplate",
        "strata:iron_plate_leggings",
        "strata:iron_plate_boots",
    ],
    bonuses: [
        Bonus(pieces: 2, effects: [Stat(stat: "strata:protection", op: Add, value: 1.0)]),
        Bonus(pieces: 4, effects: [Stat(stat: "strata:protection", op: Add, value: 3.0)]),
    ],
)
