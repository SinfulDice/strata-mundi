// "Pierre" theme, chosen at the end of v0.1 (docs/maquettes, D035): neutral grey, golden
// accent. Colors: "#rrggbb" or "#rrggbbaa".
Theme(
    text: "#f2efe8",
    text_shadow: "#2a2620",
    text_dim: "#a8a29a",
    accent: "#e8c35a",
    panel: "#3b3833e8",
    panel_light: "#6a655c",
    panel_dark: "#1f1d1a",
    slot: "#24221ecc",
    slot_border: "#5a554c",
    focus: "#f2efe8",
    field: "#151412",
    gauge: "#8a7444",
    shade: "#00000080",
    // HUD bars: health red, stamina green, mana blue, food brown, thirst light blue.
    bars: {
        "health": "#c8402e",
        "stamina": "#5fa043",
        "mana": "#4a6fd0",
        "food": "#c08a3e",
        "thirst": "#4fa8d8",
        "breath": "#9ad4f0",
        "temperature": "#e0a040",
        "experience": "#8fd14f",
        "use": "#f2efe8",
    },
    hurt: "#c0201870",
)
