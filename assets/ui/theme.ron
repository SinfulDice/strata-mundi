// "Pierre" theme, chosen at the end of v0.1 (docs/maquettes, D035): neutral grey, golden
// accent. Colors: "#rrggbb" or "#rrggbbaa".
Theme(
    text: "#f2efe8",
    text_shadow: "#2a2620",
    text_dim: "#a8a29a",
    accent: "#e8c35a",
    panel: "#3b3833e8",
    panel_light: "#6a655c",
    panel_dark: "#1f1d1a",
    slot: "#24221ecc",
    slot_border: "#5a554c",
    focus: "#f2efe8",
    field: "#151412",
    gauge: "#8a7444",
    shade: "#00000080",
    // HUD bars: health red, stamina green, mana blue, food brown, thirst light blue;
    // temperature: a scale from deep blue (freezing) through green (comfortable) to red.
    bars: {
        "health": "#c8402e",
        "stamina": "#5fa043",
        "mana": "#4a6fd0",
        "food": "#c08a3e",
        "thirst": "#4fa8d8",
        "breath": "#9ad4f0",
        "temperature": "#6f8f5a",
        "temperature_freezing": "#3a5fc8",
        "temperature_cold": "#7fb2e0",
        "temperature_hot": "#e0a040",
        "temperature_scorching": "#c8402e",
        "experience": "#8fd14f",
        "use": "#f2efe8",
    },
    hurt: "#c0201870",
    // Edges of the screen when cold (frost) or hot (heat), stronger in the harmful zones.
    frost: "#dcefff90",
    heat: "#ff8c30a8",
    // Strength of those edges (0 to 1) when cold or hot, and when freezing or scorching
    // (halved with « Reduce camera effects »); seconds the temperature hint stays.
    temperature: (edges_straining: 0.45, edges_harmful: 1.0, hint_seconds: 8.0),
)
