// HUD editor: the HUD is drawn underneath with every element selectable.
Screen(
    root: [
        Panel(
            id: "window",
            anchor: Left,
            at: (4, 0),
            size: (136, 84),
            children: [
                Label(id: "title", anchor: TopLeft, at: (6, 5), text: "ui-editor-title"),
                Label(id: "select", anchor: TopLeft, at: (6, 18), text: "ui-editor-help-select", dim: true),
                Label(id: "move", anchor: TopLeft, at: (6, 30), text: "ui-editor-help-move", dim: true),
                Button(id: "reset", anchor: BottomLeft, at: (6, -6), size: (60, 18), text: "ui-editor-reset"),
                Button(id: "done", anchor: BottomRight, at: (-6, -6), size: (60, 18), text: "ui-editor-done"),
            ],
        ),
    ],
)
