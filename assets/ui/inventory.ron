// Survival inventory with its 2×2 crafting grid; at a crafting table, the 3×3 grid; with
// a container open, the container on top. The player's slots are always below. Slots
// take clicks (the help below gives way to the crafting hint or the recipe learnt): left takes or puts, right halves or puts one, shift-click sends across
// (on the result: crafts as many as fit), double-click gathers, middle click (L1) locks.
Screen(
    root: [
        Shade,
        Panel(
            id: "window",
            anchor: Center,
            at: (0, 0),
            size: (196, 238),
            children: [
                Group(id: "player_side", children: [
                    Label(id: "title", anchor: TopLeft, at: (8, 4), text: "ui-inventory-survival-title"),
                    SlotGrid(id: "armor", anchor: TopLeft, at: (8, 16), columns: 1, rows: 4),
                    SlotGrid(id: "offhand", anchor: TopLeft, at: (32, 76), columns: 1, rows: 1),
                    Label(id: "offhand_label", anchor: TopLeft, at: (56, 82), text: "ui-inventory-offhand", dim: true),
                    SlotGrid(id: "craft", anchor: TopLeft, at: (34, 20), columns: 2, rows: 2),
                    Label(id: "craft_arrow", anchor: TopLeft, at: (76, 36), text: "ui-craft-arrow", dim: true),
                    SlotGrid(id: "craft_result", anchor: TopLeft, at: (86, 30), columns: 1, rows: 1),
                    Button(id: "sort_type", anchor: TopLeft, at: (112, 16), size: (76, 14), text: "ui-inventory-sort-type"),
                    Button(id: "sort_name", anchor: TopLeft, at: (112, 32), size: (76, 14), text: "ui-inventory-sort-name"),
                    Button(id: "deposit", anchor: TopLeft, at: (112, 48), size: (76, 14), text: "ui-inventory-deposit"),
                    Button(id: "book", anchor: TopLeft, at: (112, 64), size: (76, 14), text: "ui-inventory-journal"),
                    Label(id: "help", anchor: TopLeft, at: (8, 100), text: "@help", dim: true, wrap: Some(180)),
                ]),
                Group(id: "table_side", children: [
                    Label(id: "station_title", anchor: TopLeft, at: (8, 4), text: "@station_title"),
                    SlotGrid(id: "table", anchor: TopLeft, at: (30, 22), columns: 3, rows: 3),
                    Label(id: "table_arrow", anchor: TopLeft, at: (96, 48), text: "ui-craft-arrow", dim: true),
                    SlotGrid(id: "table_result", anchor: TopLeft, at: (110, 42), columns: 1, rows: 1),
                    Button(id: "book", anchor: TopLeft, at: (112, 86), size: (76, 14), text: "ui-inventory-journal"),
                    Label(id: "craft_note", anchor: TopLeft, at: (8, 112), text: "@craft_note", wrap: Some(180)),
                ]),
                Group(id: "chest_side", children: [
                    Label(id: "chest_title", anchor: TopLeft, at: (8, 4), text: "@title"),
                    TextField(id: "search", anchor: TopLeft, at: (8, 15), size: (92, 12), placeholder: "ui-search"),
                    Button(id: "sort_chest", anchor: TopLeft, at: (104, 13), size: (40, 14), text: "ui-inventory-sort"),
                    Button(id: "deposit", anchor: TopLeft, at: (148, 13), size: (40, 14), text: "ui-inventory-deposit"),
                    SlotGrid(id: "chest", anchor: TopLeft, at: (8, 30), columns: 9, rows: 6),
                ]),
                SlotGrid(id: "main", anchor: TopLeft, at: (8, 152), columns: 9, rows: 3),
                SlotGrid(id: "hotbar", anchor: TopLeft, at: (8, 214), columns: 9, rows: 1),
            ],
        ),
    ],
)
