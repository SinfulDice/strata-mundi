// Survival inventory with its 2×2 crafting grid; at a crafting table, the 3×3 grid; at a
// stonecutter, its cell and the variants to choose; the backpack worn on the back beside the off hand; the
// accessories (two rings, an amulet, a belt, a cloak) under the buttons, named by the tooltips of their empty slots; at an anvil, the item, the material,
// the upgrades it can take (shown by their material) and the repair; at a bench (forge,
// tannery, loom, jeweller), its four cells, the list of what it makes (scrolled by rows) and the
// result, in the bench's own arrangement (`layout` of its `benches/` file) and colour (bands); with a container open, the container
// (or the furnace: input, fuel and its flame, the arrow, output, upgrade slots) on top, a tall chest scrolled by
// rows, its upgrade slots and filter in a panel beside the window; an open bag's crafting grid and tank in a
// panel on the other side. The player's slots are always below. Slots
// take clicks (the help below gives way to the crafting hint or the recipe learnt): left takes or puts, right halves or puts one, shift-click sends across
// (on the result: crafts as many as fit), double-click gathers, middle click (L1) locks.
Screen(
    root: [
        Shade,
        Panel(
            id: "window",
            anchor: Center,
            at: (0, 0),
            size: (196, 238),
            children: [
                Group(id: "player_side", children: [
                    Label(id: "title", anchor: TopLeft, at: (8, 4), text: "ui-inventory-survival-title"),
                    SlotGrid(id: "armor", anchor: TopLeft, at: (8, 16), columns: 1, rows: 4),
                    SlotGrid(id: "offhand", anchor: TopLeft, at: (32, 76), columns: 1, rows: 1),
                    SlotGrid(id: "back", anchor: TopLeft, at: (56, 76), columns: 1, rows: 1),
                    Label(id: "offhand_label", anchor: TopLeft, at: (8, 96), text: "ui-inventory-offhand", dim: true),
                    Label(id: "protection", anchor: TopLeft, at: (34, 62), text: "@protection"),
                    SlotGrid(id: "craft", anchor: TopLeft, at: (34, 20), columns: 2, rows: 2),
                    Label(id: "craft_arrow", anchor: TopLeft, at: (76, 36), text: "ui-craft-arrow", dim: true),
                    SlotGrid(id: "craft_result", anchor: TopLeft, at: (86, 30), columns: 1, rows: 1),
                    Button(id: "sort_type", anchor: TopLeft, at: (112, 16), size: (76, 14), text: "ui-inventory-sort-type"),
                    Button(id: "sort_name", anchor: TopLeft, at: (112, 32), size: (76, 14), text: "ui-inventory-sort-name"),
                    Button(id: "deposit", anchor: TopLeft, at: (112, 48), size: (76, 14), text: "ui-inventory-deposit"),
                    Button(id: "book", anchor: TopLeft, at: (112, 64), size: (76, 14), text: "ui-inventory-journal"),
                    SlotGrid(id: "accessories", anchor: TopLeft, at: (88, 80), columns: 5, rows: 1),
                    Label(id: "help", anchor: TopLeft, at: (8, 106), text: "@help", dim: true, wrap: Some(180)),
                ]),
                Group(id: "table_side", children: [
                    Label(id: "station_title", anchor: TopLeft, at: (8, 4), text: "@station_title"),
                    SlotGrid(id: "table", anchor: TopLeft, at: (30, 22), columns: 3, rows: 3),
                    Label(id: "table_arrow", anchor: TopLeft, at: (96, 48), text: "ui-craft-arrow", dim: true),
                    SlotGrid(id: "table_result", anchor: TopLeft, at: (110, 42), columns: 1, rows: 1),
                    Button(id: "book", anchor: TopLeft, at: (112, 86), size: (76, 14), text: "ui-inventory-journal"),
                    Label(id: "craft_note", anchor: TopLeft, at: (8, 112), text: "@craft_note", wrap: Some(180)),
                ]),
                Group(id: "chest_side", children: [
                    Label(id: "chest_title", anchor: TopLeft, at: (8, 4), text: "@title"),
                    TextField(id: "search", anchor: TopLeft, at: (8, 15), size: (92, 12), placeholder: "ui-search"),
                    Button(id: "sort_chest", anchor: TopLeft, at: (104, 13), size: (40, 14), text: "ui-inventory-sort"),
                    Button(id: "deposit", anchor: TopLeft, at: (148, 13), size: (40, 14), text: "ui-inventory-deposit"),
                    SlotGrid(id: "chest", anchor: TopLeft, at: (8, 30), columns: 9, rows: 5),
                    Label(id: "chest_inventory", anchor: TopLeft, at: (8, 139), text: "ui-storage-inventory", dim: true),
                ]),
                Group(id: "furnace_side", children: [
                    Label(id: "furnace_title", anchor: TopLeft, at: (8, 4), text: "@title"),
                    SlotGrid(id: "furnace_input", anchor: TopLeft, at: (40, 20), columns: 1, rows: 1),
                    Gauge(id: "furnace_flame", anchor: TopLeft, at: (46, 43), size: (8, 14), vertical: true),
                    SlotGrid(id: "furnace_fuel", anchor: TopLeft, at: (40, 60), columns: 1, rows: 1),
                    Gauge(id: "furnace_arrow", anchor: TopLeft, at: (66, 47), size: (26, 6)),
                    SlotGrid(id: "furnace_output", anchor: TopLeft, at: (98, 40), columns: 1, rows: 1),
                    Label(id: "furnace_modules_label", anchor: TopLeft, at: (122, 16), text: "ui-furnace-modules", dim: true),
                    SlotGrid(id: "furnace_modules", anchor: TopLeft, at: (126, 28), columns: 3, rows: 2),
                    Group(id: "furnace_no_modules", children: [
                        Label(id: "furnace_no_modules_note", anchor: TopLeft, at: (122, 30), text: "ui-furnace-no-modules", dim: true, wrap: Some(66)),
                    ]),
                    Label(id: "furnace_info", anchor: TopLeft, at: (8, 92), text: "@furnace_info", wrap: Some(180)),
                    Label(id: "furnace_help", anchor: TopLeft, at: (8, 112), text: "ui-furnace-help", dim: true, wrap: Some(180)),
                ]),
                Group(id: "cutter_side", children: [
                    Label(id: "cutter_title", anchor: TopLeft, at: (8, 4), text: "@station_title"),
                    SlotGrid(id: "cutter", anchor: TopLeft, at: (16, 40), columns: 1, rows: 1),
                    ItemGrid(id: "cut_choices", anchor: TopLeft, at: (48, 20), columns: 4, rows: 3),
                    Label(id: "cutter_arrow", anchor: TopLeft, at: (134, 46), text: "ui-craft-arrow", dim: true),
                    SlotGrid(id: "cutter_result", anchor: TopLeft, at: (150, 40), columns: 1, rows: 1),
                    Label(id: "cutter_note", anchor: TopLeft, at: (8, 100), text: "@cutter_note", dim: true, wrap: Some(180)),
                ]),
                Group(id: "anvil_side", children: [
                    Label(id: "anvil_title", anchor: TopLeft, at: (8, 4), text: "@station_title"),
                    SlotGrid(id: "anvil", anchor: TopLeft, at: (8, 24), columns: 2, rows: 1),
                    Button(id: "anvil_repair", anchor: TopLeft, at: (8, 46), size: (40, 14), text: "ui-anvil-repair-button"),
                    ItemGrid(id: "anvil_choices", anchor: TopLeft, at: (56, 16), columns: 4, rows: 2),
                    Group(id: "anvil_scroll", children: [
                        Button(id: "anvil_earlier", anchor: TopLeft, at: (56, 58), size: (38, 12), text: "ui-anvil-earlier"),
                        Button(id: "anvil_later", anchor: TopLeft, at: (98, 58), size: (38, 12), text: "ui-anvil-later"),
                    ]),
                    Label(id: "anvil_arrow", anchor: TopLeft, at: (140, 30), text: "ui-craft-arrow", dim: true),
                    SlotGrid(id: "anvil_result", anchor: TopLeft, at: (156, 24), columns: 1, rows: 1),
                    Label(id: "anvil_note", anchor: TopLeft, at: (8, 74), text: "@anvil_note", wrap: Some(180)),
                ]),
                Group(id: "bench_side", children: [
                    // Any other bench: cells, list, result in a row.
                    Group(id: "bench_layout_plain", children: [
                        Band(id: "bench_band_title", anchor: TopLeft, at: (4, 2), size: (188, 12)),
                        Label(id: "bench_title", anchor: TopLeft, at: (8, 4), text: "@station_title"),
                        Band(id: "bench_band_work", anchor: TopLeft, at: (4, 18), size: (48, 48)),
                        SlotGrid(id: "bench", anchor: TopLeft, at: (8, 22), columns: 2, rows: 2),
                        ItemGrid(id: "bench_choices", anchor: TopLeft, at: (56, 18), columns: 5, rows: 3),
                        Label(id: "bench_arrow", anchor: TopLeft, at: (159, 40), text: "ui-craft-arrow", dim: true),
                        SlotGrid(id: "bench_result", anchor: TopLeft, at: (168, 34), columns: 1, rows: 1),
                        Group(id: "bench_scroll", children: [
                            Button(id: "bench_earlier", anchor: TopLeft, at: (56, 80), size: (40, 12), text: "ui-bench-earlier"),
                            Button(id: "bench_later", anchor: TopLeft, at: (100, 80), size: (40, 12), text: "ui-bench-later"),
                        ]),
                        Label(id: "bench_note", anchor: TopLeft, at: (8, 96), text: "@bench_note", dim: true, wrap: Some(180)),
                    ]),
                    // Jeweller: the cells and the result on velvet, the list beside them.
                    Group(id: "bench_layout_jeweller", children: [
                        Band(id: "bench_band_title", anchor: TopLeft, at: (4, 2), size: (188, 12)),
                        Label(id: "bench_title", anchor: TopLeft, at: (8, 4), text: "@station_title"),
                        Band(id: "bench_band_work", anchor: TopLeft, at: (4, 18), size: (48, 48)),
                        SlotGrid(id: "bench", anchor: TopLeft, at: (8, 22), columns: 2, rows: 2),
                        Band(id: "bench_band_result", anchor: TopLeft, at: (14, 70), size: (28, 28)),
                        SlotGrid(id: "bench_result", anchor: TopLeft, at: (18, 74), columns: 1, rows: 1),
                        ItemGrid(id: "bench_choices", anchor: TopLeft, at: (60, 18), columns: 5, rows: 3),
                        Group(id: "bench_scroll", children: [
                            Button(id: "bench_earlier", anchor: TopLeft, at: (60, 80), size: (40, 12), text: "ui-bench-earlier"),
                            Button(id: "bench_later", anchor: TopLeft, at: (104, 80), size: (40, 12), text: "ui-bench-later"),
                        ]),
                        Label(id: "bench_note", anchor: TopLeft, at: (8, 104), text: "@bench_note", dim: true, wrap: Some(180)),
                    ]),
                    // Forge: the list on the left, the cells on the hearth, the result beside it.
                    Group(id: "bench_layout_forge", children: [
                        Band(id: "bench_band_title", anchor: TopLeft, at: (4, 2), size: (188, 12)),
                        Label(id: "bench_title", anchor: TopLeft, at: (8, 4), text: "@station_title"),
                        ItemGrid(id: "bench_choices", anchor: TopLeft, at: (8, 18), columns: 5, rows: 3),
                        Group(id: "bench_scroll", children: [
                            Button(id: "bench_earlier", anchor: TopLeft, at: (8, 80), size: (40, 12), text: "ui-bench-earlier"),
                            Button(id: "bench_later", anchor: TopLeft, at: (52, 80), size: (40, 12), text: "ui-bench-later"),
                        ]),
                        Band(id: "bench_band_work", anchor: TopLeft, at: (112, 16), size: (80, 52)),
                        SlotGrid(id: "bench", anchor: TopLeft, at: (116, 22), columns: 2, rows: 2),
                        Label(id: "bench_arrow", anchor: TopLeft, at: (159, 36), text: "ui-craft-arrow", dim: true),
                        SlotGrid(id: "bench_result", anchor: TopLeft, at: (168, 30), columns: 1, rows: 1),
                        Label(id: "bench_note", anchor: TopLeft, at: (8, 96), text: "@bench_note", dim: true, wrap: Some(180)),
                    ]),
                    // Tannery: the cells in a row like hides on a rack, the result at its end, the list below.
                    Group(id: "bench_layout_tannery", children: [
                        Band(id: "bench_band_title", anchor: TopLeft, at: (4, 2), size: (188, 12)),
                        Label(id: "bench_title", anchor: TopLeft, at: (8, 4), text: "@station_title"),
                        Band(id: "bench_band_work", anchor: TopLeft, at: (4, 16), size: (88, 28)),
                        SlotGrid(id: "bench", anchor: TopLeft, at: (8, 20), columns: 4, rows: 1),
                        Label(id: "bench_arrow", anchor: TopLeft, at: (95, 26), text: "ui-craft-arrow", dim: true),
                        SlotGrid(id: "bench_result", anchor: TopLeft, at: (106, 20), columns: 1, rows: 1),
                        ItemGrid(id: "bench_choices", anchor: TopLeft, at: (8, 48), columns: 5, rows: 3),
                        Group(id: "bench_scroll", children: [
