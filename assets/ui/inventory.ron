                            Button(id: "bench_later", anchor: TopLeft, at: (114, 64), size: (40, 12), text: "ui-bench-later"),
                        ]),
                        Label(id: "bench_note", anchor: TopLeft, at: (8, 112), text: "@bench_note", dim: true, wrap: Some(180)),
                    ]),
                    // Loom: the cells in a column like a warp, the list and the result beside it.
                    Group(id: "bench_layout_loom", children: [
                        Band(id: "bench_band_title", anchor: TopLeft, at: (4, 2), size: (188, 12)),
                        Label(id: "bench_title", anchor: TopLeft, at: (8, 4), text: "@station_title"),
                        Band(id: "bench_band_work", anchor: TopLeft, at: (4, 16), size: (28, 88)),
                        SlotGrid(id: "bench", anchor: TopLeft, at: (8, 20), columns: 1, rows: 4),
                        ItemGrid(id: "bench_choices", anchor: TopLeft, at: (36, 18), columns: 5, rows: 3),
                        Label(id: "bench_arrow", anchor: TopLeft, at: (140, 40), text: "ui-craft-arrow", dim: true),
                        SlotGrid(id: "bench_result", anchor: TopLeft, at: (150, 34), columns: 1, rows: 1),
                        Group(id: "bench_scroll", children: [
                            Button(id: "bench_earlier", anchor: TopLeft, at: (36, 80), size: (40, 12), text: "ui-bench-earlier"),
                            Button(id: "bench_later", anchor: TopLeft, at: (80, 80), size: (40, 12), text: "ui-bench-later"),
                        ]),
                        Label(id: "bench_note", anchor: TopLeft, at: (36, 96), text: "@bench_note", dim: true, wrap: Some(152)),
                    ]),
                ]),
                SlotGrid(id: "main", anchor: TopLeft, at: (8, 152), columns: 9, rows: 3),
                SlotGrid(id: "hotbar", anchor: TopLeft, at: (8, 214), columns: 9, rows: 1),
            ],
        ),
        // A chest's or a barrel's upgrades beside the window, and the filter of the filter
        // or destruction upgrade chosen: the carried item goes in a cell (A), an empty hand
        // empties it.
        // An open bag's crafting upgrade (a 3×3 grid and its result) and tank upgrade (the
        // carried bucket pours in or fills up) beside the window.
        Group(id: "bag_side", children: [
            Panel(
                id: "window_bag",
                anchor: Center,
                at: (-148, 0),
                size: (92, 238),
                children: [
                    Group(id: "bag_crafting", children: [
                        Label(id: "bag_craft_label", anchor: TopLeft, at: (8, 4), text: "ui-bag-crafting"),
                        SlotGrid(id: "bag_craft", anchor: TopLeft, at: (19, 16), columns: 3, rows: 3),
                        SlotGrid(id: "bag_craft_result", anchor: TopLeft, at: (37, 78), columns: 1, rows: 1),
                        Label(id: "bag_craft_note", anchor: TopLeft, at: (8, 100), text: "@craft_note", dim: true, wrap: Some(76)),
                    ]),
                    Group(id: "bag_tank", children: [
                        Label(id: "tank_label", anchor: TopLeft, at: (8, 116), text: "ui-bag-tank"),
                        Gauge(id: "tank_level", anchor: TopLeft, at: (8, 128), size: (76, 8)),
                        Label(id: "tank_contents", anchor: TopLeft, at: (8, 140), text: "@tank_contents", wrap: Some(76)),
                        Button(id: "tank", anchor: TopLeft, at: (8, 164), size: (76, 14), text: "ui-bag-tank-use"),
                        Label(id: "tank_help", anchor: TopLeft, at: (8, 182), text: "ui-bag-tank-help", dim: true, wrap: Some(76)),
                    ]),
                ],
            ),
        ]),
        Group(id: "storage_side", children: [
            Panel(
                id: "window_upgrades",
                anchor: Center,
                at: (148, 0),
                size: (92, 238),
                children: [
                    Group(id: "storage_upgrades", children: [
                        Label(id: "upgrades_label", anchor: TopLeft, at: (8, 4), text: "ui-storage-upgrades"),
                        SlotGrid(id: "chest_upgrades", anchor: TopLeft, at: (10, 16), columns: 4, rows: 2),
                    ]),
                    Group(id: "storage_filter", children: [
                        Label(id: "filter_title", anchor: TopLeft, at: (8, 58), text: "@filter_title", wrap: Some(76)),
                        Group(id: "filter_choices", children: [
                            Button(id: "filter_next", anchor: TopLeft, at: (8, 70), size: (76, 12), text: "ui-storage-filter-next"),
                        ]),
                        SlotGrid(id: "chest_filter", anchor: TopLeft, at: (16, 86), columns: 3, rows: 3),
                        Button(id: "filter_mode", anchor: TopLeft, at: (8, 144), size: (76, 14), text: "@filter_mode"),
                        Label(id: "filter_help", anchor: TopLeft, at: (8, 162), text: "ui-storage-filter-help", dim: true, wrap: Some(76)),
                    ]),
                    // A storage taller than the screen scrolls by rows (or with the wheel over it).
                    Group(id: "chest_scroll", children: [
                        Label(id: "chest_rows", anchor: TopLeft, at: (8, 208), text: "@chest_rows", dim: true),
