// Survival inventory; with a container open, the container on top and the player's
// slots below. The slots take clicks: left takes or puts, right halves or puts one,
// shift-click sends across, double-click gathers, middle click (L1) locks.
Screen(
    root: [
        Shade,
        Panel(
            id: "window",
            anchor: Center,
            at: (0, 0),
            size: (196, 238),
            children: [
                Group(id: "player_side", children: [
                    Label(id: "title", anchor: TopLeft, at: (8, 4), text: "ui-inventory-survival-title"),
                    SlotGrid(id: "armor", anchor: TopLeft, at: (8, 16), columns: 1, rows: 4),
                    SlotGrid(id: "offhand", anchor: TopLeft, at: (32, 76), columns: 1, rows: 1),
                    Label(id: "offhand_label", anchor: TopLeft, at: (56, 82), text: "ui-inventory-offhand", dim: true),
                    Button(id: "sort_type", anchor: TopLeft, at: (108, 16), size: (80, 16), text: "ui-inventory-sort-type"),
                    Button(id: "sort_name", anchor: TopLeft, at: (108, 34), size: (80, 16), text: "ui-inventory-sort-name"),
                    Button(id: "deposit", anchor: TopLeft, at: (108, 52), size: (80, 16), text: "ui-inventory-deposit"),
                    Label(id: "help", anchor: TopLeft, at: (8, 100), text: "ui-inventory-survival-help", dim: true, wrap: Some(180)),
                ]),
                Group(id: "chest_side", children: [
                    Label(id: "chest_title", anchor: TopLeft, at: (8, 4), text: "@title"),
                    TextField(id: "search", anchor: TopLeft, at: (8, 15), size: (92, 12), placeholder: "ui-search"),
                    Button(id: "sort_chest", anchor: TopLeft, at: (104, 13), size: (40, 14), text: "ui-inventory-sort"),
                    Button(id: "deposit", anchor: TopLeft, at: (148, 13), size: (40, 14), text: "ui-inventory-deposit"),
                    SlotGrid(id: "chest", anchor: TopLeft, at: (8, 30), columns: 9, rows: 6),
                ]),
                SlotGrid(id: "main", anchor: TopLeft, at: (8, 152), columns: 9, rows: 3),
                SlotGrid(id: "hotbar", anchor: TopLeft, at: (8, 214), columns: 9, rows: 1),
            ],
        ),
    ],
)
