// New world: name, seed (empty = random), world border, game mode, liquids, day cycle, fire,
// world type and the generation editor (world_generation.ron).
Screen(
    root: [
        Panel(
            id: "window",
            anchor: Center,
            at: (0, 0),
            size: (240, 218),
            children: [
                Label(id: "title", anchor: TopLeft, at: (8, 5), text: "ui-new-world-title"),
                Label(id: "name_label", anchor: TopLeft, at: (8, 17), text: "ui-new-world-name", dim: true),
                TextField(id: "name", anchor: TopLeft, at: (8, 27), size: (224, 12), placeholder: "ui-new-world-name"),
                Label(id: "seed_label", anchor: TopLeft, at: (8, 41), text: "ui-new-world-seed", dim: true),
                TextField(id: "seed", anchor: TopLeft, at: (8, 51), size: (224, 12), placeholder: "ui-new-world-seed-random"),
                Label(id: "border_label", anchor: TopLeft, at: (8, 65), text: "ui-new-world-border", dim: true),
                TextField(id: "border", anchor: TopLeft, at: (8, 75), size: (224, 12), placeholder: "ui-new-world-border"),
                Button(id: "mode", anchor: TopLeft, at: (8, 92), size: (224, 14), text: "@mode"),
                Button(id: "fluids", anchor: TopLeft, at: (8, 108), size: (224, 14), text: "@fluids"),
                Button(id: "day_cycle", anchor: TopLeft, at: (8, 124), size: (224, 14), text: "@day_cycle"),
                Button(id: "fire_spread", anchor: TopLeft, at: (8, 140), size: (110, 14), text: "@fire_spread"),
                Button(id: "fire_destroy", anchor: TopLeft, at: (122, 140), size: (110, 14), text: "@fire_destroy"),
                Slider(id: "world_type", anchor: TopLeft, at: (8, 158), size: (224, 14)),
                Button(id: "customize", anchor: TopLeft, at: (8, 174), size: (224, 14), text: "ui-new-world-customize"),
                Button(id: "create", anchor: BottomLeft, at: (8, -6), size: (108, 16), text: "ui-new-world-create"),
                Button(id: "back", anchor: BottomRight, at: (-8, -6), size: (108, 16), text: "ui-back"),
            ],
        ),
    ],
)
