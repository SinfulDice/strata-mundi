// Settings: one tab per family, one row per setting (left/right or click to change),
// and below, what the focused setting does and costs. 11 rows at once
// (`VISIBLE_ROWS` in screens/options.rs).
Screen(
    root: [
        Shade,
        Panel(
            id: "window",
            anchor: Center,
            at: (0, 0),
            size: (300, 218),
            children: [
                Label(id: "title", anchor: TopLeft, at: (8, 4), text: "ui-options-title"),
                Tabs(id: "tabs", anchor: TopLeft, at: (8, 17), size: (284, 13)),
                OptionList(id: "options", anchor: TopLeft, at: (8, 34), size: (284, 143), row_height: 13),
                Label(id: "description", anchor: TopLeft, at: (8, 181), text: "@description", dim: true),
                Button(id: "back", anchor: BottomRight, at: (-8, -5), size: (70, 16), text: "ui-back"),
                Label(id: "help", anchor: BottomLeft, at: (8, -8), text: "ui-options-help", dim: true),
            ],
        ),
    ],
)
